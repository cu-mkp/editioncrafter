Year 1564.
Engraved by Harman Muller.</p></div></body></text><facsimile xml:id="prints"><surface xml:id="f0001" ulx="0" uly="0" lrx="1000" lry="800" sameAs="/corpus/6285564874d5f7a229b60520/Image/62bf69e7264417b1394de67e"><label>Veelderhande cierli… (Title Page)</label><graphic mimeType="application/json" url="https://corpora.dh.tamu.edu/iiif/2/corpora/6285564874d5f7a229b60520/Image/4de6/62bf69e7264417b1394de67e/files/RP-P-1952-397A.jpg" /></surface><surface xml:id="f0001" ulx="0" uly="0" lrx="1000" lry="800" sameAs="/corpus/6285564874d5f7a229b60520/Image/686c6b16a3da12d491d55c40"><label>Veelderhande cierli… (Title Page)</label><graphic mimeType="application/json" url="https://iiif.micr.io/QbASN" /></surface><surface xml:id="f0002" ulx="0" uly="0" lrx="1000" lry="800" sameAs="/corpus/6285564874d5f7a229b60520/Image/686c6b16a3da12d491d55c43"><label>Veelderhande cierli… (2)</label><graphic mimeType="application/json" url="https://iiif.micr.io/UbLqG" /></surface><surface xml:id="f0003" ulx="0" uly="0" lrx="1000" lry="800" sameAs="/corpus/6285564874d5f7a229b60520/Image/686c6b16a3da12d491d55c45"><label>Veelderhande cierli… (3)</label><graphic mimeType="application/json" url="https://iiif.micr.io/zhUxL" /></surface><surface xml:id="f0004" ulx="0" uly="0" lrx="1000" lry="800" sameAs="/corpus/6285564874d5f7a229b60520/Image/686c6b16a3da12d491d55c48"><label>Veelderhande cierli… (4)</label><graphic mimeType="application/json" url="https://iiif.micr.io/rLoaS" /></surface><surface xml:id="f0005" ulx="0" uly="0" lrx="1000" lry="800" sameAs="/corpus/6285564874d5f7a229b60520/Image/686c6b16a3da12d491d55c4a"><label>Veelderhande cierli… (5)</label><graphic mimeType="application/json" url="https://iiif.micr.io/Wecri" /></surface><surface xml:id="f0006" ulx="0" uly="0" lrx="1000" lry="800" sameAs="/corpus/6285564874d5f7a229b60520/Image/686c6b16a3da12d491d55c4c"><label>Veelderhande cierli… (6)</label><graphic mimeType="application/json" url="https://iiif.micr.io/mZzMx" /></surface><surface xml:id="f